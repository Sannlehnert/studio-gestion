# Desarrollo local; las credenciales de Compose siguientes no sirven para producción.
DATABASE_URL="postgresql://studio:studio_dev@localhost:5432/studio_gestion_dev?schema=public"
PORT=3000
NODE_ENV=development
BUSINESS_TIMEZONE="America/Argentina/Buenos_Aires"
FRONTEND_ORIGIN="http://localhost:5173"
# Origins adicionales exactos, separados por coma. Sin rutas, comodines ni credenciales.
FRONTEND_ORIGINS="http://localhost:5173"
API_ORIGIN="http://localhost:3000"
SESSION_COOKIE_NAME="session"
ADMIN_SESSION_TTL_MS=86400000
STUDENT_SESSION_TTL_MS=2592000000
COOKIE_SECURE=false
SWAGGER_ENABLED=true
# Producción: HTTPS, COOKIE_SECURE=true, SWAGGER_ENABLED=false; preferir __Host-session.
# false para acceso directo. Detrás de proxy, indicar únicamente sus IPs/CIDRs confiables.
TRUST_PROXY=false
BODY_LIMIT_BYTES=16384
RATE_API_LIMIT=300
RATE_API_WINDOW_MS=60000
RATE_LOGIN_LIMIT=10
RATE_LOGIN_WINDOW_MS=900000
RATE_ACTIVATION_LIMIT=60
RATE_ACTIVATION_WINDOW_MS=900000
RATE_ACCESS_LIMIT=30
RATE_ACCESS_WINDOW_MS=900000
# Obligatorios únicamente para ejecutar seed. Sin credenciales por defecto.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
