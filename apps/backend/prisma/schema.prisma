generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------- Enums ---------

enum StudentAccessStatus {
  PENDING
  ACTIVATED
  REVOKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum RecoveryStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

// --------- Models ---------

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentsCreated   Payment[]      @relation("PaymentCreatedBy")
  paymentsVoided    Payment[]      @relation("PaymentVoidedBy")
  sessionsCancelled ClassSession[] @relation("ClassSessionCancelledBy")
}

model Student {
  id        String   @id @default(uuid())
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  enrollments   Enrollment[]
  attendances   Attendance[]
  recoveries    Recovery[]
  accessTokens  StudentAccess[]
}

model StudentAccess {
  id          String              @id @default(uuid())
  studentId   String
  tokenHash   String              @unique
  status      StudentAccessStatus @default(PENDING)
  expiresAt   DateTime
  activatedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  classCount  Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("ARS") @db.VarChar(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(uuid())
  studentId      String
  planId         String
  planName       String             @db.VarChar(120)
  classAllowance Int
  agreedPrice    Decimal            @db.Decimal(10, 2)
  currency       String             @db.VarChar(3)
  periodStart    DateTime
  periodEnd      DateTime
  status         SubscriptionStatus @default(ACTIVE)
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan        Plan         @relation(fields: [planId], references: [id])
  payments    Payment[]
  enrollments Enrollment[]
  recoveries  Recovery[]

  @@index([studentId, status, periodStart, periodEnd])
  @@index([planId])
  @@unique([id, studentId])
}

model Payment {
  id               String         @id @default(uuid())
  subscriptionId   String
  createdByAdminId String
  voidedByAdminId  String?
  idempotencyKey   String         @unique @db.VarChar(64)
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @db.VarChar(3)
  status           PaymentStatus  @default(CONFIRMED)
  paidAt           DateTime
  method           PaymentMethod?
  note             String?        @db.VarChar(500)
  voidedAt         DateTime?
  voidReason       String?        @db.VarChar(500)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  createdByAdmin Admin        @relation("PaymentCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  voidedByAdmin  Admin?       @relation("PaymentVoidedBy", fields: [voidedByAdminId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, status, paidAt])
  @@index([createdByAdminId])
  @@index([voidedByAdminId])
}

model Schedule {
  id              String   @id @default(uuid())
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int
  defaultCapacity Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classSessions ClassSession[]
  enrollments   Enrollment[]

  @@index([dayOfWeek, startMinute, id])
}

model ClassSession {
  id                 String             @id @default(uuid())
  scheduleId         String
  occurrenceDate     DateTime           @db.Date
  startAt            DateTime
  endAt              DateTime
  capacity           Int
  status             ClassSessionStatus @default(SCHEDULED)
  cancelledAt        DateTime?
  cancelledByAdminId String?
  cancellationReason String?            @db.VarChar(500)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  schedule    Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  cancelledBy Admin?       @relation("ClassSessionCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: Restrict)
  attendances Attendance[]
  recoveries  Recovery[]   @relation("RecoverySession")

  @@unique([scheduleId, occurrenceDate])
  @@index([occurrenceDate, status])
  @@index([startAt, endAt])
  @@index([cancelledByAdminId])
}

model Enrollment {
  id             String   @id @default(uuid())
  studentId      String
  subscriptionId String
  scheduleId     String
  validFrom      DateTime @db.Date
  validUntil     DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId, studentId], references: [id, studentId], onDelete: Restrict)
  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([studentId, validFrom, validUntil])
  @@index([subscriptionId, validFrom, validUntil])
  @@index([scheduleId, validFrom, validUntil])
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  classSessionId String
  status         AttendanceStatus @default(PRESENT)
  markedAt       DateTime         @default(now())
  note           String?

  recovery Recovery? @relation("RecoveryOriginalAbsence")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSessionId])
  @@index([classSessionId])
}

model Recovery {
  id                String         @id @default(uuid())
  studentId         String
  subscriptionId    String
  originalAbsenceId String
  recoverySessionId String
  status            RecoveryStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  usedAt            DateTime?
  expiresAt         DateTime?
  note              String?

  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  originalAbsence Attendance   @relation("RecoveryOriginalAbsence", fields: [originalAbsenceId], references: [id])
  recoverySession ClassSession @relation("RecoverySession", fields: [recoverySessionId], references: [id])

  @@unique([originalAbsenceId])
  @@index([studentId, subscriptionId])
  @@index([recoverySessionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum SessionRole {
  ADMIN
  STUDENT
}

model Session {
  id         String      @id @default(uuid())
  userId     String
  role       SessionRole
  tokenHash  String      @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())

  @@index([userId, role])
  @@index([expiresAt])
}
